# Settings for career-kit. Copied to .env by setup.sh.

# The ports it runs on, all on 127.0.0.1. Blank means the default (8100, 8140, 8120, 5180).
# Set them when another program has one; start.sh and Claude read them from here.
API_PORT=
CAREER_PORT=
NETWORKING_PORT=
WEB_PORT=

# Both can stay blank when only this Mac opens the page; they are for reaching it from your
# phone over Tailscale (see README).

# Who may use it over the tailnet: your Tailscale login emails, comma separated.
TAILNET_LOGINS=

# This Mac's tailnet names, comma separated (for example your-mac.your-tailnet.ts.net).
TAILNET_HOSTS=
